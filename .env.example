# EventPulse Configuration
PROJECT_NAME="EventPulse"
ENVIRONMENT="development"
DEBUG=true

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/eventpulse"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/eventpulse"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Webhook Dispatch Settings
MAX_RETRIES=5
DELIVERY_TIMEOUT_SECONDS=3.0
DEFAULT_HMAC_SECRET="eventpulse_super_secret_signing_key_change_me"

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=100
CIRCUIT_BREAKER_RESET_SECONDS=600

# Admin & API Security
ADMIN_API_KEY="eventpulse_admin_secret_token"

